# Cerebro environment template.
# Copy to .env and fill in values. .env is gitignored; this file is not.
# Never commit a real key. Transport details belong in config/provider.yaml,
# not here.

# ---------------------------------------------------------------------------
# Phase 2 — agent provider (spec 008 Task 6)
# ---------------------------------------------------------------------------
# Supplied by the hackathon organizers. Never commit the real value.
CEREBRO_API_KEY=
CEREBRO_MODEL=
CEREBRO_BASE_URL=
CEREBRO_MODEL_REVISION=
CEREBRO_INPUT_PRICE_PER_MILLION=
CEREBRO_OUTPUT_PRICE_PER_MILLION=

# ---------------------------------------------------------------------------
# Phase 1 — semantic layer (optional, unchanged)
# ---------------------------------------------------------------------------
# Read by enrichment.py and retrieval.py only. Without these, `cerebro generate`
# reports fallback mode and retrieval runs in lexical_graph mode. Neither fails.
OPENAI_API_KEY=
CEREBRO_OPENAI_MODEL=gpt-5.4-mini
CEREBRO_EMBEDDING_MODEL=text-embedding-3-small
