# Cerebro environment template. Copy to .env and never commit real keys.
CEREBRO_DATABASE_PATH=/absolute/path/to/workshop.duckdb
CEREBRO_DATABASE_SCHEMA=main

# Semantic generation and optional embedding provider.
CEREBRO_LLM_PROVIDER_ID=openai-compatible
CEREBRO_LLM_PROVIDER_NAME=OpenAI-compatible
CEREBRO_LLM_BASE_URL=https://api.openai.com/v1
CEREBRO_LLM_API_KEY=
CEREBRO_LLM_MODEL=
CEREBRO_LLM_RESPONSE_MODE=auto
CEREBRO_LLM_TIMEOUT_SECONDS=120
CEREBRO_LLM_MAX_OUTPUT_TOKENS=8192
CEREBRO_LLM_MAX_RETRIES=2
CEREBRO_LLM_RETRY_BACKOFF_SECONDS=2
CEREBRO_EMBEDDING_MODEL=

# Authorization-bound Text-to-SQL organizer provider (spec 008).
CEREBRO_API_KEY=
CEREBRO_MODEL=
CEREBRO_BASE_URL=https://api.openai.com/v1

# Legacy OpenAI-compatible aliases remain supported.
OPENAI_API_KEY=
CEREBRO_OPENAI_MODEL=gpt-5.4-mini
