CEREBRO_DATABASE_PATH=/data/workshop.duckdb
CEREBRO_DATABASE_SCHEMA=main
CEREBRO_LLM_BASE_URL=https://api.example.invalid/v1
CEREBRO_LLM_API_KEY=replace-on-server
CEREBRO_LLM_MODEL=replace-on-server
CEREBRO_LLM_PROVIDER_ID=greennode-compatible
CEREBRO_LLM_PROVIDER_NAME=GreenNode-compatible
CEREBRO_LLM_RESPONSE_MODE=auto
CEREBRO_LLM_TIMEOUT_SECONDS=120
CEREBRO_LLM_MAX_OUTPUT_TOKENS=8192
CEREBRO_LLM_MAX_RETRIES=2
CEREBRO_QUERY_ROW_LIMIT=100
CEREBRO_QUERY_TIMEOUT_SECONDS=10

# Fallback app-level Basic Auth, gating every route including /mcp and the static
# SPA. Set only if the deployment target provides no equivalent gateway/access-
# control layer of its own (e.g. GreenNode Agent Runtime, unlike the vServer +
# Caddy path, may not). Leave both unset to disable this entirely.
# CEREBRO_BASIC_AUTH_USER=replace-on-server
# CEREBRO_BASIC_AUTH_PASSWORD=replace-on-server
